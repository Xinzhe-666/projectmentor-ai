# Copy this file to .env on the server. Never commit the resulting .env file.
# Use unique production values; the placeholders below are intentionally invalid.
MYSQL_ROOT_PASSWORD=replace-with-a-unique-random-database-password
JWT_SECRET=replace-with-a-high-entropy-secret-of-at-least-32-characters
ADMIN_EMAILS=your-admin@example.com

# Vite reads this value while the frontend image is built, not at container runtime.
VITE_WORKBENCH_EXPERIENCE_ENABLED=true

# Whether to enable Knife4j API docs. Keep false in production.
KNIFE4J_ENABLED=false
# Comma-separated exact HTTPS browser origins allowed to call /api/**.
# Do not include localhost, wildcard origins, or plain HTTP in production.
CORS_ALLOWED_ORIGINS=https://projectmentorai.com,https://www.projectmentorai.com

# Keep AI disabled until a production key is configured. Never commit the key.
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MAX_PROMPT_CHARS=12000
AI_MAX_RESPONSE_TOKENS=1600

# Flyway owns database schema changes. Enable baseline only for a reviewed legacy database's first migration-aware startup.
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false

# Email verification for registration. Keep false until SMTP is configured.
EMAIL_VERIFICATION_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
EMAIL_VERIFICATION_SUBJECT=ProjectMentor AI 邮箱验证码
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_EMAIL_HOURLY_LIMIT=5
EMAIL_VERIFICATION_IP_HOURLY_LIMIT=20
EMAIL_VERIFICATION_MAX_VERIFY_ATTEMPTS=5
