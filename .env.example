# Copy this file to .env on the server. Never commit the resulting .env file.
# Use unique production values; the placeholders below are intentionally invalid.
MYSQL_ROOT_PASSWORD=replace-with-a-unique-random-database-password
JWT_SECRET=replace-with-a-high-entropy-secret-of-at-least-32-characters
ADMIN_EMAILS=your-admin@example.com

# Vite reads this value while the frontend image is built, not at container runtime.
VITE_WORKBENCH_EXPERIENCE_ENABLED=true

# Whether to enable Knife4j API docs. Keep false in production.
KNIFE4J_ENABLED=false
# Comma-separated exact HTTPS browser origins allowed to call /api/**.
# Do not include localhost, wildcard origins, or plain HTTP in production.
CORS_ALLOWED_ORIGINS=https://projectmentorai.com,https://www.projectmentorai.com

# Keep AI disabled until a production key is configured. Never commit the key.
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MAX_PROMPT_CHARS=12000
AI_MAX_RESPONSE_TOKENS=1600

# Conservative local audit executor defaults. Tune only from measured workload data.
ANALYSIS_EXECUTOR_CORE_POOL_SIZE=2
ANALYSIS_EXECUTOR_MAX_POOL_SIZE=4
ANALYSIS_EXECUTOR_QUEUE_CAPACITY=50
ANALYSIS_EXECUTOR_KEEP_ALIVE_SECONDS=60
ANALYSIS_EXECUTOR_AWAIT_TERMINATION_SECONDS=30

# Analysis dispatch defaults to local and does not connect to RabbitMQ.
# Set rabbit only with docker-compose.rabbit.yml or an equivalent reviewed broker deployment.
ANALYSIS_DISPATCH_MODE=local
ANALYSIS_RABBIT_HOST=
ANALYSIS_RABBIT_PORT=5672
ANALYSIS_RABBIT_AMQP_PORT=5672
ANALYSIS_RABBIT_MANAGEMENT_PORT=15672
ANALYSIS_RABBIT_VHOST=/pmai
ANALYSIS_RABBIT_USERNAME=replace-with-a-dedicated-rabbit-user
ANALYSIS_RABBIT_PASSWORD=replace-with-a-unique-random-rabbit-password
ANALYSIS_RABBIT_MAIN_EXCHANGE=pmai.analysis.v1
ANALYSIS_RABBIT_MAIN_QUEUE=pmai.analysis.execute.v1
ANALYSIS_RABBIT_MAIN_ROUTING_KEY=analysis.execute.v1
ANALYSIS_RABBIT_RETRY_EXCHANGE=pmai.analysis.retry.v1
ANALYSIS_RABBIT_DLX=pmai.analysis.dlx.v1
ANALYSIS_RABBIT_DLQ=pmai.analysis.dead.v1
ANALYSIS_RABBIT_DEAD_ROUTING_KEY=analysis.dead.v1
ANALYSIS_RABBIT_QUEUE_TYPE=quorum
ANALYSIS_RABBIT_CONFIRM_TIMEOUT_MILLIS=5000
ANALYSIS_OUTBOX_POLL_INTERVAL_MILLIS=1000
ANALYSIS_OUTBOX_BATCH_SIZE=50
ANALYSIS_OUTBOX_CLAIM_LEASE_SECONDS=30
ANALYSIS_OUTBOX_MAXIMUM_ATTEMPTS=8
ANALYSIS_OUTBOX_INITIAL_BACKOFF_SECONDS=5
ANALYSIS_OUTBOX_MAXIMUM_BACKOFF_SECONDS=300
ANALYSIS_OUTBOX_PUBLISHED_RETENTION_HOURS=168
ANALYSIS_RABBIT_CONSUMER_MIN_CONCURRENCY=1
ANALYSIS_RABBIT_CONSUMER_MAX_CONCURRENCY=4
ANALYSIS_RABBIT_PREFETCH=1
ANALYSIS_EXECUTION_LEASE_SECONDS=120
ANALYSIS_EXECUTION_HEARTBEAT_SECONDS=30
ANALYSIS_RECOVERY_SCAN_INTERVAL_MILLIS=5000
ANALYSIS_RECOVERY_BATCH_SIZE=50
ANALYSIS_EXECUTION_MAXIMUM_ATTEMPTS=4
ANALYSIS_RETRY_TTL_SECONDS=10,60,300

# Flyway owns database schema changes. Enable baseline only for a reviewed legacy database's first migration-aware startup.
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false

# Email verification for registration. Keep false until SMTP is configured.
EMAIL_VERIFICATION_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
EMAIL_VERIFICATION_SUBJECT=ProjectMentor AI 邮箱验证码
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_EMAIL_HOURLY_LIMIT=5
EMAIL_VERIFICATION_IP_HOURLY_LIMIT=20
EMAIL_VERIFICATION_MAX_VERIFY_ATTEMPTS=5
